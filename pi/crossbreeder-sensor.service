[Unit]
Description=Crossbreeder Sensor
Documentation=https://github.com/andreacoppini/crossbreeder
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/crossbreeder-sensor -config /etc/crossbreeder-sensor/config.json
Restart=always
RestartSec=5s

User=sensor
Group=sensor
# netdev owns wpa_supplicant's control socket; without it the sensor cannot
# drive the radio.
SupplementaryGroups=netdev

# CAP_NET_RAW is for the ICMP socket, the packet socket a capture and LLDP
# discovery need, and SO_BINDTODEVICE on the DHCP socket. CAP_NET_BIND_SERVICE
# is for binding UDP port 68, which is where a DHCP client has to answer. The
# sensor asks for nothing else, and runs as an unprivileged user for
# everything else it does.
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# /var/lib/crossbreeder-sensor for the history, /run/crossbreeder-sensor for
# the sockets the sensor opens to talk to wpa_supplicant.
StateDirectory=crossbreeder-sensor
RuntimeDirectory=crossbreeder-sensor
# wpa_supplicant answers a control request at the address it came from, so the
# client's own socket has to be somewhere both services can see. /run is;
# a private /tmp is not.
Environment=TMPDIR=/run/crossbreeder-sensor

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/run/wpa_supplicant

[Install]
WantedBy=multi-user.target
